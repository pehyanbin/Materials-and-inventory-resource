<UserControl x:Class="MIR.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MIR.Views"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="Report Type" FontSize="12" Foreground="{StaticResource TextLightBrush}" Margin="0,0,0,8"/>
                        <ComboBox ItemsSource="{Binding ReportTypes}" 
                                  SelectedItem="{Binding SelectedReportType}"
                                  Width="200" Height="40"
                                  VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsProductSelectionVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Select Product" FontSize="12" Foreground="{StaticResource TextLightBrush}" Margin="0,0,0,8"/>
                        <ComboBox ItemsSource="{Binding Products}" 
                                  SelectedItem="{Binding SelectedProduct}"
                                  DisplayMemberPath="Name"
                                  Width="250" Height="40"
                                  VerticalContentAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"
                            Visibility="{Binding IsProductSelectionVisible, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                    <TextBlock Text="Total Inventory Value" FontSize="12" Foreground="{StaticResource TextLightBrush}" HorizontalAlignment="Right"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding CurrencySymbol}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                        <TextBlock Text="{Binding TotalInventoryValue, StringFormat={}{0:N2}}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Title -->
        <TextBlock Grid.Row="1" Text="{Binding ReportTitle}" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

        <!-- Generic Data Table (Materials) -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0"
                Visibility="{Binding IsProductSelectionVisible, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
            <DataGrid ItemsSource="{Binding MaterialsReport}" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      BorderThickness="0"
                      Background="Transparent"
                      RowHeight="45">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="CODE" Binding="{Binding Code}" Width="120"/>
                    <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="STOCK" Binding="{Binding CurrentStock}" Width="100"/>
                    <DataGridTemplateColumn Header="STATUS" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="10" Padding="8,2" HorizontalAlignment="Left"
                                        Background="{Binding IsLowStock, Converter={StaticResource StatusBgConverter}}">
                                    <TextBlock Text="{Binding IsLowStock, Converter={StaticResource StatusTextConverter}}"
                                               FontSize="10" FontWeight="Bold" 
                                               Foreground="White"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="UNIT PRICE" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DataContext.CurrencySymbol, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    <TextBlock Text="{Binding UnitPrice, StringFormat={}{0:N2}}" Margin="2,0,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- BOM Data Table -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0"
                Visibility="{Binding IsProductSelectionVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <DataGrid ItemsSource="{Binding BomReport}" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      BorderThickness="0"
                      Background="Transparent"
                      RowHeight="45">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="MATERIAL" Binding="{Binding MaterialName}" Width="*"/>
                    <DataGridTextColumn Header="CODE" Binding="{Binding MaterialCode}" Width="150"/>
                    <DataGridTextColumn Header="REQUIRED QTY" Binding="{Binding Quantity}" Width="150"/>
                    <DataGridTextColumn Header="UNIT" Binding="{Binding MaterialUnit}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
