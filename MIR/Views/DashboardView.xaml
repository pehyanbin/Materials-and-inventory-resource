<UserControl x:Class="MIR.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MIR.Views"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Stats Overview -->
        <Grid Grid.Row="0" Margin="0,0,0,40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Total Materials -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Total Materials" Foreground="{StaticResource TextLightBrush}" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding TotalMaterials}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Total Products -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Active Products" Foreground="{StaticResource TextLightBrush}" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding TotalProducts}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Low Stock Alerts -->
            <Border Grid.Column="4" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Low Stock Alerts" Foreground="{StaticResource TextLightBrush}" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding LowStockCount}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource ErrorBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Bottom Sections -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <!-- Recent Activity -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Recent Stock Activity" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,25"/>
                    <DataGrid ItemsSource="{Binding RecentTransactions}" 
                              AutoGenerateColumns="False" CanUserAddRows="False"
                              Background="Transparent" BorderThickness="0"
                              HeadersVisibility="Column" RowHeight="45">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Material" Binding="{Binding MaterialName}" Width="*"/>
                            <DataGridTextColumn Header="Operation" Binding="{Binding Type}" Width="100"/>
                            <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="80"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding TransactionDate, StringFormat='dd/MM HH:mm'}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Low Stock List -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Low Stock Warning" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,25" Foreground="{StaticResource ErrorBrush}"/>
                    <ItemsControl ItemsSource="{Binding LowStockMaterials}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderBrush}" Padding="0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Code}" FontSize="12" Foreground="{StaticResource TextLightBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CurrentStock}" Foreground="{StaticResource ErrorBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding Unit}" FontSize="11" Foreground="{StaticResource TextLightBrush}" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
