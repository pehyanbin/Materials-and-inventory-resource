<UserControl x:Class="MIR.Views.ProductionAnalyzerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MIR.Views"
             xmlns:ViewModels="clr-namespace:MIR.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="Product to Analyze" FontSize="12" Foreground="{StaticResource TextLightBrush}" Margin="0,0,0,8"/>
                        <ComboBox ItemsSource="{Binding Products}" 
                                  SelectedItem="{Binding SelectedProduct}"
                                  DisplayMemberPath="Name"
                                  Width="300" Height="40"
                                  VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="Target Quantity" FontSize="12" Foreground="{StaticResource TextLightBrush}" Margin="0,0,0,8"/>
                        <TextBox Text="{Binding TargetQuantity, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource ModernTextBox}" 
                                 Width="100"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="Missing Value" FontSize="12" Foreground="{StaticResource TextLightBrush}" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding TotalShortageValue, StringFormat=${0}}" 
                               FontSize="24" FontWeight="Bold" 
                               Foreground="{StaticResource ErrorBrush}"
                               HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Summary Alert -->
        <Border Grid.Row="1" Background="{StaticResource PrimaryLightBrush}" 
                CornerRadius="8" Padding="16" Margin="0,0,0,24"
                Visibility="{Binding HasShortages, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠ Production Bottleneck Detected" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,12,0"/>
                <TextBlock Text="Some materials are below the required levels for this production run." Foreground="{StaticResource PrimaryBrush}"/>
            </StackPanel>
        </Border>

        <!-- Analysis Results Grid -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0">
            <DataGrid ItemsSource="{Binding AnalysisResults}" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      BorderThickness="0"
                      Background="Transparent"
                      RowHeight="50">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Material" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" Margin="10,0">
                                    <TextBlock Text="{Binding MaterialName}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding MaterialCode}" FontSize="12" Foreground="{StaticResource TextLightBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    
                    <DataGridTextColumn Header="Required" Binding="{Binding Required}" Width="100"/>
                    <DataGridTextColumn Header="Available" Binding="{Binding Available}" Width="100"/>
                    
                    <DataGridTemplateColumn Header="Shortage" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding IsBottleneck, Converter={StaticResource BoolToErrorBrushConverter}}" 
                                        CornerRadius="4" Padding="8,4" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Shortage}" 
                                               Foreground="{Binding IsBottleneck, Converter={StaticResource BoolToErrorTextBrushConverter}}" 
                                               FontWeight="Bold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Impact" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Margin="10,0">
                                    <ProgressBar Value="{Binding ImpactPercentage}" 
                                                 Maximum="100" Height="10"
                                                 Foreground="{StaticResource ErrorBrush}"
                                                 Background="{StaticResource BgGrayBrush}"
                                                 BorderThickness="0"/>
                                    <TextBlock Text="{Binding ImpactPercentage, StringFormat={}{0:N0}%}" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="10" Foreground="Black"/>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
