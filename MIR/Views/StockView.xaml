<UserControl x:Class="MIR.Views.StockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MIR.Views"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">

    <Grid Margin="40">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="30"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Column: Transactions -->
        <StackPanel Grid.Column="0">
            <!-- Stock Transaction Card -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,30">
                <StackPanel>
                    <TextBlock Text="Stock Transaction" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,25"/>

                    <TextBlock Text="Select Material" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ComboBox ItemsSource="{Binding Materials}" 
                              SelectedItem="{Binding SelectedMaterial}"
                              DisplayMemberPath="Name"
                              Height="40" Margin="0,0,0,20"/>

                    <TextBlock Text="Quantity" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding TransactionQuantity}" Margin="0,0,0,20"/>

                    <TextBlock Text="Notes" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding TransactionNotes}" Margin="0,0,0,30"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Stock IN" 
                                Style="{StaticResource PrimaryButton}" 
                                Background="{StaticResource SuccessBrush}"
                                Command="{Binding AddStockInCommand}"
                                Margin="0,0,10,0"/>
                        <Button Grid.Column="1" Content="Stock OUT" 
                                Style="{StaticResource PrimaryButton}" 
                                Background="{StaticResource WarningBrush}"
                                Command="{Binding AddStockOutCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Recent Transactions Table -->
            <Border Style="{StaticResource CardBorder}" Padding="15">
                <StackPanel>
                    <TextBlock Text="Recent Transactions" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15"/>
                    <DataGrid ItemsSource="{Binding RecentTransactions}" 
                              AutoGenerateColumns="False" CanUserAddRows="False"
                              Background="Transparent" BorderThickness="0"
                              RowHeight="40" MaxHeight="300"
                              HeadersVisibility="Column"
                              VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Material" Binding="{Binding MaterialName}" Width="*"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="60"/>
                            <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="50"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding TransactionDate, StringFormat='dd/MM HH:mm'}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Right Column: Production Check -->
        <Border Grid.Column="2" Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Production Feasibility Check" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,25"/>

                <Grid Grid.Row="1" Margin="0,0,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Margin="0,0,15,0">
                        <TextBlock Text="Target Product" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <ComboBox ItemsSource="{Binding Products}" 
                                  SelectedItem="{Binding CheckProduct}"
                                  DisplayMemberPath="Name"
                                  Height="40"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,15,0">
                        <TextBlock Text="Quantity" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding CheckQuantity}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Orientation="Horizontal">
                        <Button Content="Check Stock" 
                                Style="{StaticResource PrimaryButton}" 
                                Command="{Binding CheckProductionCommand}"
                                Width="120" Margin="0,0,10,0"/>
                        <Button Content="Max Units" 
                                Style="{StaticResource PrimaryButton}" 
                                Background="Transparent" Foreground="{StaticResource PrimaryBrush}"
                                Command="{Binding CalculateMaxCommand}"
                                BorderThickness="1" BorderBrush="{StaticResource PrimaryBrush}"
                                Width="120"/>
                    </StackPanel>
                </Grid>

                <!-- Result Message -->
                <Border Grid.Row="2" CornerRadius="8" Padding="20" Margin="0,0,0,30"
                        Background="{Binding CanProduce, Converter={StaticResource ResultBgConverter}}"
                        Visibility="{Binding CheckResult, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding CheckResult}" 
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Foreground="White"/>
                </Border>

                <!-- Shortages Table -->
                <Grid Grid.Row="3" Visibility="{Binding Shortages.Count, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Required Materials Shortage" FontWeight="SemiBold" Margin="0,0,0,15" Foreground="{StaticResource ErrorBrush}"/>
                    <Border Grid.Row="1" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" CornerRadius="8">
                        <DataGrid ItemsSource="{Binding Shortages}" 
                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                  Background="White" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Material" Binding="{Binding MaterialName}" Width="*"/>
                                <DataGridTextColumn Header="Required" Binding="{Binding Required}" Width="100"/>
                                <DataGridTextColumn Header="Available" Binding="{Binding Available}" Width="100"/>
                                <DataGridTextColumn Header="Shortage" Binding="{Binding Shortage}" Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="60"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
