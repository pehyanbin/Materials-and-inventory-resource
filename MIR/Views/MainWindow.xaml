<Window x:Class="MIR.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MIR.Views"
        xmlns:ViewModels="clr-namespace:MIR.ViewModels"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="760" Width="1260"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type ViewModels:DashboardViewModel}">
            <local:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type ViewModels:MaterialsViewModel}">
            <local:MaterialsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type ViewModels:ProductsViewModel}">
            <local:ProductsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type ViewModels:StockViewModel}">
            <local:StockView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type ViewModels:ProductionAnalyzerViewModel}">
            <local:ProductionAnalyzerView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type ViewModels:ReportsViewModel}">
            <local:ReportsView/>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="18">
        <Border CornerRadius="22" Background="#AAFFFFFF" BorderBrush="#D7E4E3" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="8" Opacity="0.08" Color="#102A2A"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="290"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0" CornerRadius="22,0,0,22" Background="{StaticResource SidebarGradientBrush}">
                    <Grid Margin="18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Padding="16" CornerRadius="16" Background="#10FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="44" Height="44" CornerRadius="12" Background="#22FFFFFF" VerticalAlignment="Center">
                                    <TextBlock Text="MIR" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="White"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock Text="Materials Intelligence" FontSize="15" FontWeight="SemiBold" Foreground="White"/>
                                    <TextBlock Text="Operations Workspace" FontSize="12" Foreground="#B8D7D5"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Margin="0,16,0,14" Padding="14" CornerRadius="14" Background="#12FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Current User" FontSize="11" Foreground="#A7CBC8"/>
                                <TextBlock Text="{Binding CurrentUserName}" Margin="0,4,0,0" Foreground="White" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding CurrentUserRole}" FontSize="12" Foreground="#CBE3E1"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Row="2">
                            <TextBlock Text="Navigation" FontSize="11" Foreground="#9FC3C0" Margin="8,0,0,8"/>
                            <RadioButton Content="Dashboard" Style="{StaticResource NavButtonStyle}" IsChecked="True" Command="{Binding NavigateCommand}" CommandParameter="Dashboard"/>
                            <RadioButton Content="Products" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Products"/>
                            <RadioButton Content="Materials" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Materials"/>
                            <RadioButton Content="Stock Entries" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Stock"/>
                            <RadioButton Content="Production Analyzer" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Analyzer"/>
                            <RadioButton Content="Reports" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Reports"/>
                        </StackPanel>

                        <Border Grid.Row="3" Margin="0,12,0,12" Padding="14" CornerRadius="14" Background="#12FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Currency" FontSize="11" Foreground="#A7CBC8"/>
                                    <TextBlock Text="{Binding CurrencySymbol}" Margin="0,4,0,0" Foreground="White" FontWeight="SemiBold"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding AvailableCurrencies}"
                                          SelectedItem="{Binding CurrencySymbol}"
                                          Height="34"
                                          Width="60"
                                          Background="#15FFFFFF"
                                          Foreground="White"
                                          BorderBrush="#2DFFFFFF"
                                          VerticalContentAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Button Grid.Row="4"
                                Content="Exit Application"
                                Command="{Binding ExitCommand}"
                                Style="{StaticResource GhostButton}"
                                Height="42"/>
                    </Grid>
                </Border>

                <!-- Main workspace -->
                <Grid Grid.Column="1" Margin="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="98"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F8FCFC" BorderBrush="#E3EEEE" BorderThickness="0,0,0,1" CornerRadius="0,22,0,0">
                        <Grid Margin="28,20,28,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Operations Console" FontSize="24" FontWeight="SemiBold"/>
                                <TextBlock Text="Plan production, track materials, monitor stock risks, and run BOM analysis."
                                           Margin="0,4,0,0"
                                           Foreground="{StaticResource TextGrayBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Padding="12,8" CornerRadius="12" Background="{StaticResource SurfaceTintStrongBrush}" BorderBrush="#D7E8E6" BorderThickness="1" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="User:" FontSize="12" Foreground="{StaticResource TextLightBrush}" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding CurrentUserName}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                                <Border Padding="12,8" CornerRadius="12" Background="White" BorderBrush="#DCEAEA" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Currency:" FontSize="12" Foreground="{StaticResource TextLightBrush}" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding CurrencySymbol}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="#F6FBFA" CornerRadius="0,0,22,22">
                        <ContentControl Content="{Binding CurrentView}"/>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
