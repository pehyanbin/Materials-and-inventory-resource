<Window x:Class="MIR.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MIR.Views"
        xmlns:ViewModels="clr-namespace:MIR.ViewModels"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgGrayBrush}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type ViewModels:DashboardViewModel}">
            <local:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type ViewModels:MaterialsViewModel}">
            <local:MaterialsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type ViewModels:ProductsViewModel}">
            <local:ProductsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type ViewModels:StockViewModel}">
            <local:StockView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type ViewModels:ProductionAnalyzerViewModel}">
            <local:ProductionAnalyzerView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation -->
        <Border Grid.Column="0" Background="White" BorderThickness="0,0,1,0" BorderBrush="{StaticResource BorderBrush}">
            <Grid Margin="20,40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand Section -->
                <StackPanel Grid.Row="0" Margin="0,0,0,40">
                    <TextBlock Text="MIR" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock Text="Inventory Management" FontSize="12" Foreground="{StaticResource TextLightBrush}"/>
                </StackPanel>

                <!-- Nav Menu -->
                <StackPanel Grid.Row="1">
                    <RadioButton Content="Dashboard" Style="{StaticResource NavButtonStyle}" IsChecked="True" Command="{Binding NavigateCommand}" CommandParameter="Dashboard"/>
                    <RadioButton Content="Products" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Products" Margin="0,5,0,0"/>
                    <RadioButton Content="Materials" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Materials" Margin="0,5,0,0"/>
                    <RadioButton Content="Stock Entries" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Stock" Margin="0,5,0,0"/>
                    <RadioButton Content="Production Analyzer" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Analyzer" Margin="0,5,0,0"/>
                    <RadioButton Content="Reports" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Reports" Margin="0,5,0,0"/>
                    <RadioButton Content="User Management" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Users" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- User Profile & Logout -->
                <Border Grid.Row="2" Padding="0,20,0,0" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding CurrentUserName}" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Text="{Binding CurrentUserRole}" FontSize="12" Foreground="{StaticResource TextLightBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="1" 
                                Content="Exit" 
                                Command="{Binding ExitCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Height="32" Padding="10,0" FontSize="12"
                                Background="Transparent" Foreground="{StaticResource ErrorBrush}"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="80"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="White" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderBrush}">
                <Grid Margin="40,0">
                    <TextBlock Text="Dashboard" VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold"/>
                </Grid>
            </Border>

            <!-- Content -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentView}"/>
        </Grid>
    </Grid>
</Window>
