<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Accent Palette (teal + deep slate) -->
    <Color x:Key="PrimaryBlue">#0F766E</Color>
    <Color x:Key="PrimaryDarkBlue">#115E59</Color>
    <Color x:Key="PrimaryLightBlue">#DFF7F4</Color>

    <!-- Neutrals -->
    <Color x:Key="BgWhite">#FFFFFF</Color>
    <Color x:Key="BgGray">#F3F7F7</Color>
    <Color x:Key="BorderGray">#DCE7E7</Color>
    <Color x:Key="TextDark">#102A2A</Color>
    <Color x:Key="TextGray">#446060</Color>
    <Color x:Key="TextLight">#7A9696</Color>

    <!-- Secondary Surface Colors -->
    <Color x:Key="PanelDark">#0B1F23</Color>
    <Color x:Key="PanelDarkAlt">#133037</Color>
    <Color x:Key="SurfaceTint">#F8FCFC</Color>
    <Color x:Key="SurfaceTintStrong">#ECF6F5</Color>

    <!-- State Colors -->
    <Color x:Key="SuccessGreen">#16A34A</Color>
    <Color x:Key="WarningOrange">#F97316</Color>
    <Color x:Key="ErrorRed">#DC2626</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryBlue}"/>
    <SolidColorBrush x:Key="PrimaryDarkBlueBrush" Color="{StaticResource PrimaryDarkBlue}"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryDarkBlue}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightBlue}"/>

    <SolidColorBrush x:Key="BgWhiteBrush" Color="{StaticResource BgWhite}"/>
    <SolidColorBrush x:Key="BgGrayBrush" Color="{StaticResource BgGray}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderGray}"/>
    <SolidColorBrush x:Key="TextDarkBrush" Color="{StaticResource TextDark}"/>
    <SolidColorBrush x:Key="TextGrayBrush" Color="{StaticResource TextGray}"/>
    <SolidColorBrush x:Key="TextLightBrush" Color="{StaticResource TextLight}"/>

    <SolidColorBrush x:Key="PanelDarkBrush" Color="{StaticResource PanelDark}"/>
    <SolidColorBrush x:Key="PanelDarkAltBrush" Color="{StaticResource PanelDarkAlt}"/>
    <SolidColorBrush x:Key="SurfaceTintBrush" Color="{StaticResource SurfaceTint}"/>
    <SolidColorBrush x:Key="SurfaceTintStrongBrush" Color="{StaticResource SurfaceTintStrong}"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessGreen}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningOrange}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorRed}"/>

    <LinearGradientBrush x:Key="AppBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F8FBFB" Offset="0"/>
        <GradientStop Color="#EDF5F4" Offset="0.45"/>
        <GradientStop Color="#E6EFEE" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SidebarGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#134d15" Offset="0"/>
        <GradientStop Color="#217c0a" Offset="0.55"/>
        <GradientStop Color="#33c809" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeroGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E8FAF7" Offset="0"/>
        <GradientStop Color="#D7F1EE" Offset="0.5"/>
        <GradientStop Color="#F7FCFB" Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>
